# STOCKALERT · plantilla de configuración
# Copiar a .env en la raíz del proyecto. NUNCA versionar secretos reales.

NODE_ENV=development
PORT=4000

# Neon: use la URL pooler aquí y la URL directa para migraciones.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_URL=postgresql://USUARIO:CONTRASENA@HOST.REGION.aws.neon.tech/DB?sslmode=require
DB_SSL=true

# Genere un valor aleatorio de al menos 32 caracteres. No dejar vacío.
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000

# Asistente IA de STOCKALERT: OpenAI. Solo en el backend (nunca variables VITE_*).
# Sin clave, el chat informa que el asistente está temporalmente fuera de servicio.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Solo para la creación inicial local del administrador (no ejecutar en producción).
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@su-dominio.com
SEED_ADMIN_PASSWORD=REEMPLACE_CONTRASENA_INICIAL
SEED_ADMIN_ESTABLISHMENT_ID=1

# Promoción explícita y manual del superadministrador tras aplicar las migraciones 005-008.
# PROMOTE_SUPERADMIN_EMAIL=admin@su-dominio.com
# CONFIRM_PROMOTE_SUPERADMIN=true

# Credenciales SOLO de una fixture local/desechable para pruebas de integración.
# Nunca apuntar a Neon de producción.
# TEST_ADMIN_EMAIL=admin@fixture.local
# TEST_ADMIN_PASSWORD=valor-de-la-fixture
# TEST_CONSULTA_EMAIL=consulta@fixture.local
# TEST_CONSULTA_PASSWORD=valor-de-la-fixture
# TEST_ADMIN_ESTABLISHMENT_ID=1
# E2E_EMAIL=admin@fixture.local
# E2E_PASSWORD=valor-de-la-fixture
# E2E_HOME_PATH=/
# ALLOW_NONLOCAL_TESTS=true

# Solo si el propietario autoriza aplicar migraciones a una base no local.
# ALLOW_PRODUCTION_MIGRATION=true
