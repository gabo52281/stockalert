{
  "name": "stockalert",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema web de gestión y control de inventarios con alertas preventivas e IA local",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run test --workspace=backend",
    "test:unit": "npm run test:unit --workspace=backend",
    "test:fields": "npm run test:fields --workspace=frontend",
    "test:numeric-e2e": "npm run test:numeric-e2e --workspace=frontend",
    "test:integration": "npm run test:integration --workspace=backend",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend",
    "start": "node backend/src/server.js",
    "migrate": "node backend/src/scripts/migrate.js up",
    "migrate:down": "node backend/src/scripts/migrate.js down",
    "migrate:status": "node backend/src/scripts/migrate.js status",
    "seed": "node backend/src/scripts/seed.js",
    "admin": "node backend/src/scripts/createAdmin.js"
  },
  "engines": {
    "node": ">=20"
  }
}
